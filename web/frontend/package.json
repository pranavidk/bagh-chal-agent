{
  "name": "baghchal-web",
  "private": true,
  "version": "1.0.0",
  "description": "Browser UI for playing the Bagh-Chal agent; compiled into ../static/app.js",
  "scripts": {
    "build": "esbuild src/main.jsx --bundle --minify --target=es2019 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --outfile=../static/app.js",
    "watch": "esbuild src/main.jsx --bundle --jsx=automatic --define:process.env.NODE_ENV='\"development\"' --outfile=../static/app.js --watch"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
